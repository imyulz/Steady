{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/calendar", "dest": "/steady-calendar.html" },
    { "src": "/log", "dest": "/steady-log.html" },
    { "src": "/stretch", "dest": "/steady-stretch.html" },
    { "src": "/memo", "dest": "/steady-memo.html" }
  ]
}
